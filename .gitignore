# Dependências
node_modules/
jspm_packages/
.pnpm-store/

# Segurança e Chaves (CRÍTICO)
.env
.env.*
!.env.example
*.pem
*.key
cert.json
service-account.json

# Logs e Performance
Logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache e Arquivos Temporários do Sistema
.vector_cache.json
.vector_cache_v2.json
.DS_Store
Thumbs.db
.cache/
.tmp/
temp/

# Working Memory — JSONs individuais de sessão (ruído para o Git)
# São consolidados diariamente em *_consolidated.md
Cerebro/Memoria-RAG/*_wm_*.json

# Arquivos de desenvolvimento/debug temporários
Scripts/core/nohup_v3.out
Scripts/core/core
Scripts/core/patch_*.py
Scripts/core/_test_payload.json
Scripts/core/test_*.mjs
Scripts/core/test_*.js

# Obsidian — estado local da interface (não versionável)
Cerebro/.obsidian/workspace.json
Cerebro/.obsidian/workspace-mobile.json
Cerebro/.obsidian/graph.json
Cerebro/.obsidian/appearance.json

# Backups Locais
*.zip
*.tar.gz
*.7z
