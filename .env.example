# Chronos-VPS — variáveis de ambiente
# Copie para .env e preencha antes de subir o docker-compose.

# --- Segurança / Gatekeeper (mesma chave que as IAs externas usam pra conectar) ---
API_SECRET_KEY=troque_por_uma_chave_longa_aleatoria

# --- Telegram ---
TELEGRAM_BOT_TOKEN=seu_token_do_botfather

# --- Fallback em nuvem (opcional, mesmo padrão do Chronos mobile) ---
GEMINI_API_KEY=

# --- LLM local ---
LLM_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LLM_CTX_SIZE=4096
LLM_MEM_LIMIT=10g

# --- MCP server ---
MCP_HEAP_MB=512
