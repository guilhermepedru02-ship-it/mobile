{
  "version": "1.2.0",
  "description": "Regras de delegacao, retry e controle de custos para a Arquitetura do Enxame (FASE 3) — Chronos Local",
  "updated_at": "2026-05-31",
  "author": "Claude Sonnet 4.6 via sessao MCP",

  "retry_policy": {
    "max_local_attempts": 2,
    "local_timeout_ms": 50000,
    "fallback_on_timeout": true,
    "fallback_on_error": true,
    "fallback_on_empty_response": true
  },

  "delegation_rules": {
    "always_local": [
      "ram_status", "disk_usage", "git_status", "git_log",
      "tech_news", "kanban_read", "diary_today",
      "llm_status", "services_health", "self_health_check",
      "workspace_agent_status", "list_tools", "memory_write"
    ],
    "prefer_cloud": [
      "architecture_decision",
      "complex_debugging",
      "creative_writing",
      "detailed_code_generation",
      "detailed_analysis",
      "milestone_planning"
    ],
    "auto": [
      "KNOWLEDGE_QUERY",
      "CODE_TASK",
      "CREATIVE_TASK"
    ]
  },

  "cloud_backends": [
    {
      "name": "gemini",
      "model": "gemini-2.0-flash",
      "max_tokens": 1000,
      "priority": 1,
      "api_key_env": "GEMINI_API_KEY",
      "_setup_note": "Definir GEMINI_API_KEY no arquivo .env do Workspace antes de usar"
    }
  ],

  "cost_control": {
    "max_cloud_calls_per_day": 20,
    "alert_at_percent": 80,
    "track_usage": true,
    "usage_log": "Logs/cloud_usage.json"
  },

  "silent_execution": {
    "enabled": true,
    "log_background_tasks": true,
    "background_log": "Logs/background_tasks.log"
  }
}
