    {
      "name": "workspace_agent",
      "description": "Mini-agente local para micro-tarefas de workspace. Use para: ler arquivos, escrever arquivos, executar scripts existentes, aplicar patches, rodar comandos shell e retornar stdout. NÃO use para raciocínio complexo ou decisões de arquitetura.",
      "endpoint": "http://localhost:3333",
      "type": "mcp_tool",
      "available_routes": [
        "/read_file",
        "/write_file",
        "/append_file",
        "/delete_file",
        "/move_file",
        "/list_dir",
        "/run_script",
        "/shell_exec",
        "/apply_patch",
        "/health",
        "/capabilities"
      ],
      "started_by": "Scripts/bootstrap/03_start_services.sh",
      "script": "Scripts/core/workspace_agent_server.js"
    },
    {
      "name": "cloud_bridge",
      "description": "Ponte para IAs em nuvem (consult_expert_ia). Use quando o agente local falhar 2 vezes ou para tarefas de raciocínio pesado.",
