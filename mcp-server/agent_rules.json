{
    "version": "1.3.0",
    "description": "Regras de delegacao, retry e controle de custos para a Arquitetura do Enxame (FASE 3) — Chronos Local",
    "updated_at": "2026-06-08",
    "author": "Antigravity via sessao MCP",
    "retry_policy": {
        "max_local_attempts": 2,
        "local_timeout_ms": 50000,
        "fallback_on_timeout": true,
        "fallback_on_error": true,
        "fallback_on_empty_response": true
    },
    "delegation_rules": {
        "always_local": [
            "ram_status",
            "disk_usage",
            "git_status",
            "git_log",
            "tech_news",
            "kanban_read",
            "diary_today",
            "llm_status",
            "services_health",
            "self_health_check",
            "workspace_agent_status",
            "list_tools",
            "memory_write"
        ],
        "prefer_cloud": [
            "architecture_decision",
            "complex_debugging",
            "creative_writing",
            "detailed_code_generation",
            "detailed_analysis",
            "milestone_planning"
        ],
        "auto": [
            "KNOWLEDGE_QUERY",
            "CODE_TASK",
            "CREATIVE_TASK"
        ]
    },
    "cloud_backends": [
        {
            "name": "nvidia",
            "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
            "model": "meta/llama-3.1-8b-instruct",
            "api_key_env": "NVIDIA_API_KEY",
            "max_tokens": 4096,
            "priority": 1,
            "timeout_ms": 30000,
            "_note": "Llama 3.1 8B - rapido e estavel. Testado OK em 2026-06-08"
        },
        {
            "name": "nvidia_heavy",
            "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
            "model": "qwen/qwen3.5-122b-a10b",
            "api_key_env": "NVIDIA_API_KEY",
            "max_tokens": 4096,
            "priority": 2,
            "timeout_ms": 90000,
            "_note": "Qwen 122B - modelo pesado. Reserva para tarefas complexas"
        }
    ],
    "cost_control": {
        "max_cloud_calls_per_day": 100,
        "alert_at_percent": 80,
        "track_usage": true,
        "usage_log": "Logs/cloud_usage.json"
    },
    "silent_execution": {
        "enabled": true,
        "log_background_tasks": true,
        "background_log": "Logs/background_tasks.log"
    }
}
